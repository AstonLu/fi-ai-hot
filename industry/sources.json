        "itemsPath": "items",
        "titlePaths": [
          "originalTitle",
          "title"
        ],
        "summaryPaths": [
          "summary"
        ],
        "publishedAtPath": "publishedAt",
        "externalIdPath": "id",
        "urlTemplate": "{raw:links.original}"
