    {
      "id": "json-aihot-selected",
      "name": "AIHOT 精選（aihot.news）",
      "kind": "json_list",
      "config": {
        "url": "https://aihot.news/api/v1/items?mode=selected&window=24h&limit=100",
        "mode": "json_api",
        "itemsPath": "items",
        "titlePaths": [
          "originalTitle",
          "title"
        ],
        "summaryPaths": [
          "summary"
        ],
        "publishedAtPath": "publishedAt",
        "externalIdPath": "id",
        "urlTemplate": "{raw:links.original}"
      },
      "tier": "T2",
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 60,
